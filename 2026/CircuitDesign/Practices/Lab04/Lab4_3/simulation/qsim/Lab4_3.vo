cycloneiii_lcell_comb \inst4|x1 (
// Equation(s):
// \inst4|x1~combout  = (\z1~input_o  & ((\z2~input_o ) # ((\z3~input_o  & \z4~input_o )))) # (!\z1~input_o  & (\z3~input_o  & (\z4~input_o )))

