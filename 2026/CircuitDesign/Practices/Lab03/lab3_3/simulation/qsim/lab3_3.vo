`timescale 1 ps/ 1 ps

module behavioral (
	F_sop,
	F_pos,
	A,
	B,
	C);
output 	F_sop;
output 	F_pos;
input 	A;
input 	B;
input 	C;

// Design Ports Information
// F_sop	=>  Location: PIN_J2,	 I/O Standard: 2.5 V,	 Current Strength: Default
// F_pos	=>  Location: PIN_J1,	 I/O Standard: 2.5 V,	 Current Strength: Default
// A	=>  Location: PIN_J6,	 I/O Standard: 2.5 V,	 Current Strength: Default
// B	=>  Location: PIN_H5,	 I/O Standard: 2.5 V,	 Current Strength: Default
// C	=>  Location: PIN_H6,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \F_sop~output_o ;
wire \F_pos~output_o ;
wire \C~input_o ;
wire \A~input_o ;
wire \B~input_o ;
wire \comb_4|F~0_combout ;


// Location: IOOBUF_X0_Y20_N2
cycloneiii_io_obuf \F_sop~output (
	.i(\comb_4|F~0_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\F_sop~output_o ),
	.obar());
// synopsys translate_off
defparam \F_sop~output .bus_hold = "false";
defparam \F_sop~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOOBUF_X0_Y20_N9
cycloneiii_io_obuf \F_pos~output (
	.i(\comb_4|F~0_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\F_pos~output_o ),
