module behavioral (F_sop, F_pos, A, B, C);
	input A, B, C;
	output F_sop, F_pos;
	
	behavioral_pos (F_pos, A, B, C);
	behavioral_sop (F_sop, A, B, C);
endmodule 

module structural_pos (F, A, B, C);
	input A, B, C;
	output F;
	
	not(_A, A);
	not(_B, B);
	not(_C, C);
	
	
	or(tmp1, A, B, C);
	or(tmp2, A, _B, _C);
	or(tmp3, _A, B, C);
	
	and(F, tmp1, tmp2, tmp3);
endmodule 

